# ── Banco de dados ─────────────────────────────────────────────
DATABASE_URL="postgresql://sarta:sarta@localhost:5432/sarta_saas"

# ── Redis / Filas ───────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET="troque-por-um-secret-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"

# ── URLs ───────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
NODE_ENV="development"

# ── Credenciais de providers ficam no banco (tabela provider_connections) ──
# As chaves abaixo são apenas para desenvolvimento/seed local
LOYVERSE_ACCESS_TOKEN=""
