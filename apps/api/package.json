  },
  "dependencies": {
    "@sarta/shared": "workspace:*",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@prisma/client": "^5.14.0",
    "bullmq": "^5.12.0",
    "jose": "^5.6.3",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "fastify": "^4.27.0",
    "ioredis": "^5.3.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0"
